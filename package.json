{
  "name": "konteros",
  "version": "1.0.0",
  "description": "Aplikasi Retail Konter Pulsa & Multi-Layanan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @konteros/api dev",
    "dev:web": "pnpm --filter @konteros/web dev",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "build:api": "pnpm --filter @konteros/api build",
    "build:web": "pnpm --filter @konteros/web build",
    "build": "pnpm build:api && pnpm build:web",
    "lint": "pnpm --filter @konteros/api lint && pnpm --filter @konteros/web lint",
    "test": "pnpm --filter @konteros/api test && pnpm --filter @konteros/web test",
    "db:generate": "pnpm --filter @konteros/api db:generate",
    "db:push": "pnpm --filter @konteros/api db:push",
    "db:migrate": "pnpm --filter @konteros/api db:migrate",
    "db:studio": "pnpm --filter @konteros/api db:studio",
    "db:seed": "pnpm --filter @konteros/api db:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}