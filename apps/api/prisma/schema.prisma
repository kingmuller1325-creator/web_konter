// Prisma Schema for Konteros Retail Application
// This is the core database schema supporting single outlet with multi-outlet ready design

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Outlet {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  products     Product[]
  categories   Category[]
  customers    Customer[]
  transactions Transaction[]
  shifts       Shift[]
  stockMoves   StockMovement[]
  settings     Setting[]
  syncMetadata SyncMetadata[]

  @@index([isActive])
}

model User {
  id           String   @id @default(uuid())
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  refreshToken String?
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shifts       Shift[]
  transactions Transaction[]
  auditLogs    AuditLog[]

  @@index([outletId])
  @@index([email])
  @@index([role])
  @@index([refreshToken])
}

enum Role {
  ADMIN
  CASHIER
  TECHNICIAN
}

model Category {
  id        String    @id @default(uuid())
  outletId  String
  outlet    Outlet    @relation(fields: [outletId], references: [id])
  name      String
  slug      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@unique([outletId, slug])
  @@index([outletId, isActive])
}

model Product {
  id          String   @id @default(uuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  sku         String
  barcode     String?
  name        String
  description String?
  unit        String   @default("pcs")
  costPrice   Decimal  @db.Decimal(12, 2) @default(0)
  sellPrice   Decimal  @db.Decimal(12, 2) @default(0)
  stockQty    Int      @default(0)          // cached; source of truth = StockMovement
  minStock    Int      @default(0)
  isActive    Boolean  @default(true)
  isDigital   Boolean  @default(false)     // pulsa, kuota, token, etc.
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items           TransactionItem[]
  stockMovements  StockMovement[]

  @@unique([outletId, sku])
  @@index([outletId, barcode])
  @@index([outletId, name])
  @@index([outletId, categoryId])
  @@index([outletId, isActive])
  @@index([outletId, isDigital])
}

model StockMovement {
  id         String            @id @default(uuid())
  outletId   String
  outlet     Outlet            @relation(fields: [outletId], references: [id])
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  type       StockMovementType
  qty        Int               // signed: positive for IN, negative for OUT (source of truth for stock)
  refType    String?           // 'transaction' | 'adjustment' | 'purchase' | 'service' | 'return'
  refId      String?
  note       String?
  createdBy  String?
  createdAt  DateTime          @default(now())

  @@index([outletId, productId, createdAt])
  @@index([outletId, refType, refId])
  @@index([outletId, type])
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model Customer {
  id        String   @id @default(uuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([outletId, phone])
  @@index([outletId, name])
}

model Shift {
  id           String    @id @default(uuid())
  outletId     String
  outlet       Outlet    @relation(fields: [outletId], references: [id])
  cashierId    String
  cashier      User      @relation(fields: [cashierId], references: [id])
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingCash  Decimal   @db.Decimal(12, 2) @default(0)
  closingCash  Decimal?  @db.Decimal(12, 2)
  expectedCash Decimal?  @db.Decimal(12, 2)
  difference   Decimal?  @db.Decimal(12, 2)
  status       ShiftStatus @default(OPEN)
  notes        String?

  transactions Transaction[]

  @@index([outletId, status])
  @@index([outletId, openedAt])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Transaction {
  id            String            @id @default(uuid())   // server id
  clientTxnId   String            @unique                 // idempotency key from client (UUID)
  outletId      String
  outlet        Outlet            @relation(fields: [outletId], references: [id])
  cashierId     String?
  cashier       User?             @relation(fields: [cashierId], references: [id])
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id])
  shiftId       String?
  shift         Shift?            @relation(fields: [shiftId], references: [id])
  subtotal      Decimal           @db.Decimal(12, 2)
  discount      Decimal           @db.Decimal(12, 2) @default(0)
  tax           Decimal           @db.Decimal(12, 2) @default(0)
  total         Decimal           @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        TransactionStatus @default(COMPLETED)
  note          String?
  createdAt     DateTime          @default(now())        // client timestamp (offline)
  serverReceivedAt DateTime       @default(now())        // server received timestamp
  syncedAt      DateTime?
  voidedAt      DateTime?
  voidReason    String?
  voidedBy      String?
  updatedAt     DateTime          @updatedAt

  items    TransactionItem[]
  payments Payment[]

  @@index([outletId, createdAt])
  @@index([outletId, status])
  @@index([outletId, shiftId])
  @@index([clientTxnId])
  @@index([outletId, cashierId, createdAt])
}

enum TransactionStatus {
  COMPLETED
  VOIDED
  PENDING_SYNC
  FAILED
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  EWALLET
  SPLIT
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  productName   String      // snapshot name at transaction time
  productSku    String      // snapshot sku at transaction time
  qty           Int
  unitPrice     Decimal     @db.Decimal(12, 2)
  costPrice     Decimal     @db.Decimal(12, 2) // for profit calculation
  discount      Decimal     @db.Decimal(12, 2) @default(0)
  subtotal      Decimal     @db.Decimal(12, 2)

  @@index([transactionId])
  @@index([productId])
}

model Payment {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Decimal     @db.Decimal(12, 2)
  reference     String?     // approval code, VA number, etc.
  createdAt     DateTime    @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  outletId  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // 'CREATE_PRODUCT', 'VOID_TRANSACTION', 'ADJUST_STOCK', etc.
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([outletId, createdAt])
  @@index([entity, entityId])
  @@index([action])
}

model Setting {
  id        String @id @default(uuid())
  outletId  String?
  outlet    Outlet? @relation(fields: [outletId], references: [id])
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([outletId, key])
}

// Sync metadata for offline clients
model SyncMetadata {
  id        String   @id @default(uuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  deviceId  String
  entity    String   // 'products', 'customers', 'categories', 'transactions'
  lastSyncedAt DateTime @default(now())
  lastPulledAt DateTime?

  @@unique([outletId, deviceId, entity])
  @@index([outletId, deviceId])
}